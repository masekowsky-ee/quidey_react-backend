# Copy to .env and fill in. .env is git-ignored; never commit real values.

# PostgreSQL connection (database created from schema.sql)
DB_USER=
DB_HOST=localhost
DB_NAME=quidey
DB_PASSWORD=
DB_PORT=5432

# Long random string used to sign login tokens
JWT_SECRET=
PORT=3000

# Frontend origins allowed to call the API from a browser, comma separated.
# Default when empty: http://localhost:5173,http://localhost:4173 (vite dev / preview)
CORS_ORIGINS=

# Set to 1 when running behind a reverse proxy (nginx, Caddy) so rate limiting
# sees the real client IP instead of the proxy's
TRUST_PROXY=
