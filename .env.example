# Copy to .env and fill in. .env is git-ignored; never commit real values.
# See DEPLOYMENT-SECURITY.md before putting the server online.

# "production" on the server: no error details for clients, HSTS header, warnings for missing settings
NODE_ENV=

# PostgreSQL connection (database created from schema.sql).
# On the server: the limited role from scripts/db-app-role.sql (quidey_app), never postgres.
DB_USER=
DB_HOST=localhost
DB_NAME=quidey
DB_PASSWORD=
DB_PORT=5432

# Long random string used to sign login tokens (at least 32 characters, the server refuses to
# start otherwise). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Changing it signs everybody out.
JWT_SECRET=
PORT=3000

# Frontend origins allowed to call the API from a browser, comma separated, exactly as the
# browser shows them (scheme, no trailing slash), e.g. https://app.quidey.com (the app; the
# landing page on quidey.com never calls the API)
# Default when empty: http://localhost:5173,http://localhost:4173 (vite dev / preview)
CORS_ORIGINS=

# Only behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel): the number of proxies in front
# of the server, usually 1, so rate limits see the real client IP. Leave EMPTY when clients
# connect to Node directly: with it set, anybody could fake their IP and dodge the limits.
TRUST_PROXY=

# Only for automated tests, never in production: raise the rate limits / time-report slack
# RATE_LIMIT_AUTH=  RATE_LIMIT_REGISTER=  RATE_LIMIT_LOGIN_ACCOUNT=  RATE_LIMIT_VERIFICATION_MAIL=  RATE_LIMIT_CONTACT=  RATE_LIMIT_FEEDBACK=  RATE_LIMIT_DIRECT_MESSAGES=  RATE_LIMIT_API=  TIME_REPORT_SLACK_MS=  REMINDER_CHECK_MS=

# Mails (email verification). Without SMTP_HOST no mail is sent: the server only logs the
# verification link to the console (fine for development, never on the real server).
# SMTP_PORT 587 with STARTTLS; MAIL_FROM is the sender address, e.g. no-reply@quidey.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Where messages from the contact form and the feedback page go (your own inbox). The form is the second way to reach
# you that the Impressum needs. Without it, messages are only logged to the console.
CONTACT_TO=

# Public address of the frontend, used for the links in mails (no trailing slash),
# e.g. https://app.quidey.com (the app, not the landing page). Default when empty: http://localhost:5173
FRONTEND_URL=
